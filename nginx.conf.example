# ══════════════════════════════════════════════════════════════════════
# KONTAPRO - PLANTILLA NGINX DE PRODUCCIÓN (ALTA SEGURIDAD & SSL/TLS)
# ══════════════════════════════════════════════════════════════════════

# Redirección obligatoria de HTTP a HTTPS
server {
    listen 80;
    listen [::]:80;
    server_name kontapro.es www.kontapro.es;
    return 301 https://kontapro.es$request_uri;
}

# Redirección canónica de www a dominio raíz (o viceversa según preferencia)
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name www.kontapro.es;

    ssl_certificate /etc/letsencrypt/live/kontapro.es/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/kontapro.es/privkey.pem;

    return 301 https://kontapro.es$request_uri;
}

# Servidor principal HTTPS
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name kontapro.es;

    root /var/www/kontapro/dist;
    index index.html;

    # Certificados SSL/TLS (Let's Encrypt / Certbot)
    ssl_certificate /etc/letsencrypt/live/kontapro.es/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/kontapro.es/privkey.pem;

    # Protocolos y cifrados seguros recomendados por Mozilla SSL Configuration Generator
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305:DHE-RSA-AES128-GCM-SHA256:DHE-RSA-AES256-GCM-SHA384;

    # Optimización de sesiones SSL
    ssl_session_timeout 1d;
    ssl_session_cache shared:SSL:10m;
    ssl_session_tickets off;

    # OCSP Stapling
    ssl_stapling on;
    ssl_stapling_verify on;
    resolver 1.1.1.1 8.8.8.8 valid=300s;
    resolver_timeout 5s;

    # ── Cabeceras de Seguridad HTTP Estrictas ──
    # HSTS (Preload activo tras verificar dominio y subdominios)
    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains; preload" always;
    
    # Prevenir que el navegador adivine el MIME-type
    add_header X-Content-Type-Options "nosniff" always;
    
    # Prevenir incrustación en iframes (Anti-Clickjacking)
    add_header X-Frame-Options "DENY" always;
    
    # Control de referencia
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    
    # Política de permisos del navegador
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()" always;

    # Content Security Policy (CSP) adaptada a KontaPro
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://api.web3forms.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self' https://api.web3forms.com; object-src 'none'; upgrade-insecure-requests;" always;

    # Compresión gzip para rendimiento
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_proxied any;
    gzip_types text/plain text/css text/xml application/javascript application/x-javascript application/xml application/json image/svg+xml;

    # Enrutamiento SPA (Single Page Application)
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Caché inmutable para activos estáticos con hash
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, max-age=31536000, immutable";
        access_log off;
    }

    # Bloquear acceso a archivos ocultos (.git, .env, etc.)
    location ~ /\. {
        deny all;
        access_log off;
        log_not_found off;
    }

    # Bloquear extensiones sensibles
    location ~* \.(bak|config|sql|fla|psd|ini|log|sh|inc|swp|dist|docx|txt)$ {
        deny all;
        access_log off;
        log_not_found off;
    }
}
