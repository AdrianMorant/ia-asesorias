# ══════════════════════════════════════════════════════════════════════
# KONTAPRO - PLANTILLA DE VARIABLES DE ENTORNO PÚBLICAS (FRONTEND)
# ══════════════════════════════════════════════════════════════════════
# IMPORTANTE:
# Las variables con prefijo VITE_ son compiladas en el bundle del cliente.
# NUNCA introduzcas aquí claves privadas de base de datos ni tokens secretos.
# ══════════════════════════════════════════════════════════════════════

# Clave pública de Web3Forms para recepción de formularios (opcional, fallback por defecto activo)
VITE_WEB3FORMS_ACCESS_KEY=tu_clave_publica_aqui

# Dominio de producción oficial
VITE_SITE_URL=https://kontaprosuite.com
